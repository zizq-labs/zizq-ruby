# Defaults for the Uptime Monitor (Sinatra) example app.
#
# This file is committed; override locally in .env.local
# (gitignored) without touching the defaults that everyone else
# clones. Both foreman (via Procfile.dev) and dotenv inside the Ruby
# processes read this file at startup.

# RACK_ENV intentionally omitted — let the host process pick the
# default ("development"). Hard-coding it here means tests (which
# rely on RACK_ENV=test) would have it silently overridden by
# dotenv loading from .env.

# Zizq job-queue server.
ZIZQ_URL=http://127.0.0.1:7890
ZIZQ_CA=
ZIZQ_CLIENT_CERT=
ZIZQ_CLIENT_KEY=

# Web server (Puma) bind + port + thread count.
BIND=127.0.0.1
PORT=3000
PUMA_THREADS=5

# Comma-separated extra hostnames the dev server will accept (on top
# of localhost). Set in `.env.local` if you access the app via
# something like `magnolia.local`. Empty / unset = localhost only.
DEV_HOSTS=

# SQLite connection pool size. The embedded Zizq worker shares the
# Puma process, so the pool needs headroom for both.
DB_POOL_SIZE=10

# Where status-transition events are POSTed.
# Defaults to https://example.com/webhook so the job exercises the
# full POST path out of the box. To actually see the payloads, or to
# trigger errors and retries, point at a webhook.site URL.
WEBHOOK_URL=https://example.com/webhook

# Stable session secret so browser cookies survive across `bin/dev`
# restarts. Without this Sinatra generates a fresh random secret per
# boot, which produces "Session cookie encryptor error: invalid
# message" warnings on the first request after a restart. Override
# in `.env.local` (or production env) for real deployments.
SESSION_SECRET=dev_only_replace_in_env_local_for_stable_sessions_across_restarts
