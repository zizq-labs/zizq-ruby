source "https://rubygems.org"

# Sinatra modular app + Falcon (async-fiber) web server.
gem "sinatra",          "~> 4.0"
gem "rackup",           "~> 2.2"
gem "falcon",           "~> 0.51"

# Sequel + sqlite for storage / migrations.
gem "sequel",           "~> 5.85"
gem "sqlite3",          ">= 2.1"

# Zizq client from local source for the examples directory.
gem "zizq",             path: "../../.."

# `rake db:migrate` etc.
gem "rake",             "~> 13.0"

# Env files for ZIZQ_URL / PORT overrides.
gem "dotenv",           "~> 3.1"

group :development do
  # Boots web + worker via `bin/dev`.
  gem "foreman"
end

group :test do
  gem "minitest",       "~> 5.25"
  gem "rack-test",      "~> 2.1"
  gem "timecop",        "~> 0.9"
end
