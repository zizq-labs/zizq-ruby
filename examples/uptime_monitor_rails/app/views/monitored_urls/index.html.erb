<% content_for :title, "Uptime Monitor" %>

<header>
  <h1>Uptime Monitor</h1>
</header>

<main>
  <%= form_with model: MonitoredUrl.new, local: true, class: "url-form" do |f| %>
    <%= f.text_field :url, placeholder: "https://example.com", required: true, autofocus: true %>
    <%= f.submit "Watch" %>
  <% end %>

  <% if flash[:notice] %><p class="flash flash-notice"><%= flash[:notice] %></p><% end %>
  <% if flash[:alert]  %><p class="flash flash-alert"><%= flash[:alert]  %></p><% end %>

  <% if @monitored_urls.empty? %>
    <p class="empty">No URLs being monitored yet. Add one above.</p>
  <% else %>
    <table class="urls">
      <thead>
        <tr>
          <th>URL</th>
          <th>Status</th>
          <th>Last checked</th>
        </tr>
      </thead>
      <tbody>
        <% @monitored_urls.each do |m| %>
          <tr>
            <td class="url"><%= m.url %></td>
            <td>
              <span class="status status-<%= m.last_status || 'pending' %>">
                <%= (m.last_status || 'pending').upcase %>
              </span>
            </td>
            <td>
              <% if m.last_checked_at %>
                <%= time_ago_in_words(m.last_checked_at) %> ago
              <% else %>
                <em>pending first check</em>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</main>
