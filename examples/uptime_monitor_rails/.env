# Defaults for the Uptime Monitor example app.
#
# This file is committed; override locally in .env.local
# (gitignored) without touching the defaults that everyone else
# clones.
#
# Both foreman (via Procfile.dev) and dotenv-rails inside the Rails
# processes read this file at startup.

# Zizq job-queue server URL.
ZIZQ_URL=http://127.0.0.1:7890

# Path to the server's certificate authority, if using TLS.
ZIZQ_CA=

# Path to the client's TLS certificate, if using mTLS.
ZIZQ_CLIENT_CERT=

# Path to the client's private key, if using mTLS.
ZIZQ_CLIENT_KEY=

# Number of worker threads to run.
ZIZQ_WORKER_THREADS=2

# Number of async reactors per thread.
# When set to 1, no async reactor is started.
ZIZQ_WORKER_FIBERS=10

# Concurrency = threads * fibers.
RAILS_MAX_THREADS=20

# Rails server address.
BIND=127.0.0.1

# Rails server port.
PORT=3000
